{
  "info": {
    "name": "CV Builder — Manual QA staging",
    "description": "Коллекция запросов для проверки API CV Builder на тестовом стенде. Запросы выполняются вручную, автоматических тестов нет. Пароли и токены хранятся отдельно от коллекции. Не использовать для production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "supabase_url",
      "value": "https://jerwfvhpoanoukxiyvwq.supabase.co"
    },
    {
      "key": "anon_key",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "resume_id",
      "value": ""
    },
    {
      "key": "revision",
      "value": ""
    },
    {
      "key": "qa_origin",
      "value": "https://cv-builder-qa.vercel.app"
    }
  ],
  "item": [
    {
      "name": "Auth — manual session",
      "item": [
        {
          "name": "Sign up (controlled test mailbox)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/signup?redirect_to={{qa_origin}}/",
            "description": "Регистрация тестового пользователя. Проверьте данные пользователя в ответе; доставку письма подтверждения нужно отдельно проверить в контролируемом почтовом ящике.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Password login — copy tokens and user.id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
            "description": "Вход по email и паролю подтверждённого пользователя. При успехе сохраните access_token, refresh_token и user.id в локальные переменные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Refresh — copy new tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/token?grant_type=refresh_token",
            "description": "Обновление сессии по refresh_token. Проверьте, что ответ содержит новые токены, и замените ими значения в локальном окружении.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/user",
            "description": "Получение текущего пользователя по access_token. Сравните его ID с user_id своего тестового аккаунта."
          }
        },
        {
          "name": "Recovery email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/recover?redirect_to={{qa_origin}}/update-password",
            "description": "Запрос письма для восстановления пароля. Успешный HTTP-ответ сам по себе не подтверждает доставку: отдельно проверьте письмо и переход на /update-password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/auth/v1/logout",
            "description": "Завершение сессии пользователя. Проверьте статус ответа и отсутствие ошибки; для дальнейшей работы после выхода получите новую сессию."
          }
        }
      ]
    },
    {
      "name": "Resumes — own synthetic documents",
      "item": [
        {
          "name": "List own resumes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/resumes?user_id=eq.{{user_id}}&select=id,title,template,revision,created_at,updated_at&order=updated_at.desc,id.asc",
            "description": "Получение списка своих резюме. Сверьте ID и названия, а также порядок updated_at по убыванию и id по возрастанию при одинаковом времени."
          }
        },
        {
          "name": "Create full — set a new UUID first",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/rpc/create_resume_full",
            "description": "Создание резюме с заполненными разделами; перед отправкой задайте новый resume_id в формате UUID. При успехе проверьте out_resume_id и out_revision=1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_resume_id\": \"{{resume_id}}\",\n  \"p_title\": \"QA-A — Frontend Demo\",\n  \"p_template\": \"minimalist\",\n  \"p_data\": {\n    \"profile\": {\n      \"name\": \"Алексей Тестовый\",\n      \"email\": \"qa-a@example.test\",\n      \"about\": \"Синтетическое резюме для QA\",\n      \"avatarShape\": \"round\"\n    },\n    \"skills\": [\n      {\n        \"name\": \"React\",\n        \"level\": 3\n      }\n    ],\n    \"education\": [\n      {\n        \"institution\": \"Учебный университет\",\n        \"degree\": \"Бакалавр\",\n        \"years\": \"2020–2024\"\n      }\n    ],\n    \"experience\": [\n      {\n        \"company\": \"Example QA Lab\",\n        \"position\": \"Frontend developer\",\n        \"period\": \"2024–2025\",\n        \"description\": \"Демонстрационные интерфейсы\"\n      }\n    ],\n    \"github\": [],\n    \"projects\": [\n      {\n        \"id\": \"qa-project-a\",\n        \"name\": \"Demo task board\",\n        \"role\": \"Developer\",\n        \"techStack\": \"React\",\n        \"link\": \"https://example.test/task-board\",\n        \"period\": \"2025\",\n        \"description\": \"Учебный проект\"\n      }\n    ],\n    \"template\": \"minimalist\",\n    \"showSkillLevels\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Read by UUID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/resumes?id=eq.{{resume_id}}&select=*",
            "description": "Чтение резюме по resume_id. Проверьте ID, title, revision и данные; пустой массив может означать отсутствие документа или доступа к нему."
          }
        },
        {
          "name": "Save full resume (replace revision manually)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/rpc/save_resume_full",
            "description": "Сохранение резюме с текущим значением revision. Проверьте увеличение версии; при устаревшей версии ожидается ошибка P1005 без перезаписи документа.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_resume_id\": \"{{resume_id}}\",\n  \"p_title\": \"QA-A — Frontend Demo\",\n  \"p_template\": \"minimalist\",\n  \"p_data\": {\n    \"profile\": {\n      \"name\": \"Алексей Тестовый\",\n      \"email\": \"qa-a@example.test\",\n      \"about\": \"Синтетическое резюме для QA\",\n      \"avatarShape\": \"round\"\n    },\n    \"skills\": [\n      {\n        \"name\": \"React\",\n        \"level\": 3\n      }\n    ],\n    \"education\": [\n      {\n        \"institution\": \"Учебный университет\",\n        \"degree\": \"Бакалавр\",\n        \"years\": \"2020–2024\"\n      }\n    ],\n    \"experience\": [\n      {\n        \"company\": \"Example QA Lab\",\n        \"position\": \"Frontend developer\",\n        \"period\": \"2024–2025\",\n        \"description\": \"Демонстрационные интерфейсы\"\n      }\n    ],\n    \"github\": [],\n    \"projects\": [\n      {\n        \"id\": \"qa-project-a\",\n        \"name\": \"Demo task board\",\n        \"role\": \"Developer\",\n        \"techStack\": \"React\",\n        \"link\": \"https://example.test/task-board\",\n        \"period\": \"2025\",\n        \"description\": \"Учебный проект\"\n      }\n    ],\n    \"template\": \"minimalist\",\n    \"showSkillLevels\": true\n  },\n  \"p_expected_revision\": {{revision}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete disposable own resume",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/resumes?id=eq.{{resume_id}}&select=id",
            "description": "Удаление только своего временного резюме. Сверьте возвращённый ID, затем запросом чтения убедитесь, что документ больше не возвращается."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Read own profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/profiles?user_id=eq.{{user_id}}&select=*",
            "description": "Чтение профиля своего тестового пользователя. Сверьте user_id и заполненные поля; данные другого пользователя возвращаться не должны."
          }
        },
        {
          "name": "Upsert own synthetic profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Prefer",
                "value": "resolution=merge-duplicates,return=representation"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/profiles?on_conflict=user_id",
            "description": "Создание или обновление своего профиля с тестовыми данными. Сверьте возвращённый user_id и значения full_name, avatar_shape, email и about.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"full_name\": \"Алексей Тестовый\",\n  \"avatar_shape\": \"round\",\n  \"email\": \"qa-a@example.test\",\n  \"about\": \"Синтетические данные\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Child projections — read only",
      "item": [
        {
          "name": "skills",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/skills?resume_id=eq.{{resume_id}}&select=*",
            "description": "Чтение навыков выбранного резюме. Проверьте resume_id и соответствие навыков и уровней данным, переданным при сохранении."
          }
        },
        {
          "name": "education",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/education?resume_id=eq.{{resume_id}}&select=*",
            "description": "Чтение записей об образовании выбранного резюме. Сверьте resume_id, учебное заведение и остальные заполненные поля с исходными данными."
          }
        },
        {
          "name": "experience",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/experience?resume_id=eq.{{resume_id}}&select=*",
            "description": "Чтение опыта работы выбранного резюме. Сверьте resume_id, компанию, должность, период и описание с сохранёнными данными."
          }
        },
        {
          "name": "github_projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/github_projects?resume_id=eq.{{resume_id}}&select=*",
            "description": "Чтение GitHub-проектов выбранного резюме. Сравните записи с сохранённым разделом GitHub; если он не заполнен, ожидается пустой массив."
          }
        },
        {
          "name": "manual_projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{supabase_url}}/rest/v1/manual_projects?resume_id=eq.{{resume_id}}&select=*",
            "description": "Чтение проектов, добавленных вручную. Сверьте resume_id, названия, ссылки и описания с сохранённым резюме."
          }
        }
      ]
    },
    {
      "name": "GitHub Edge Function",
      "item": [
        {
          "name": "Import public demo repos (requires server token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{supabase_url}}/functions/v1/github-repos",
            "description": "Запрос публичных репозиториев указанного GitHub-пользователя; заранее замените демонстрационное имя. Без настроенного серверного токена возможен ответ 503 GITHUB_TOKEN_NOT_CONFIGURED — он не подтверждает успешный импорт.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"REPLACE_WITH_OWN_DEMO_USERNAME\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
